@@ -0,0 +1,74 @@
+import { createElement, useEffect, useState } from 'react'
+import type { FormEvent } from 'react'
+import { Button, Input } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import chatgptRemote from '@deepseek-ai/dsh-experimental-llm-chatgpt-browser/remote'
+
+export const inject = ['slots', 'remote']
+
+export async function apply(ctx: Context): Promise<void> {
+  const unmount = await ctx.remote.$mount(chatgptRemote)
+  ctx.effect(() => unmount)
+  ctx.inject(['remote.chatgpt'], mountAccount)
+}
+
+function mountAccount(ctx: Context): void {
+  // Only the opaque installation ID persists; account credentials stay in Worker memory.
+  let hostId = `urn:uuid:${crypto.randomUUID()}`
+  try {
+    hostId = localStorage.getItem('dsh.chatgpt.host') ?? hostId
+    localStorage.setItem('dsh.chatgpt.host', hostId)
+  } catch { /* Private browsers may deny persistent storage. */ }
+  const h = createElement
+  const value = <T>(result: { ok: true; value: T } | { ok: false; error: { message: string } }): T => {
+    if (!result.ok) throw new Error(result.error.message)
+    return result.value
+  }
+  function Account() {
+    const [email, setEmail] = useState('')
+    const [url, setUrl] = useState('')
+    const [callback, setCallback] = useState('')
+    const [busy, setBusy] = useState(false)
+    const [notice, setNotice] = useState('')
+    const status = async () => { const state = value(await ctx.remote.chatgpt.status()); setEmail(state.connected ? state.email : '') }
+    useEffect(() => { void status().catch(() => setNotice('Could not read ChatGPT connection')) }, [])
+    const run = async (task: () => Promise<void>) => {
+      setBusy(true); setNotice('')
+      try { await task() } catch (error) { setNotice(error instanceof Error ? error.message : 'ChatGPT sign-in failed') }
+      finally { setBusy(false) }
+    }
+    return h('section', { style: { padding: 24, maxWidth: 600, display: 'flex', flexDirection: 'column', alignItems: 'flex-start', gap: 12 } },
+      h('h2', null, 'ChatGPT'),
+      h('p', null, email || 'Use your ChatGPT subscription. This connection lasts until you reload or close this page.'),
+      h(Button, { variant: 'primary', disabled: busy, onClick: () => void run(async () => {
+        setCallback(''); setUrl(value(await ctx.remote.chatgpt.begin(hostId)))
+      }) }, 'Continue with ChatGPT'),
+      url && h('form', { style: { display: 'grid', gap: 12, width: '100%' }, onSubmit: (event: FormEvent<HTMLFormElement>) => {
+        event.preventDefault()
+        const pasted = callback; setCallback(''); setUrl('')
+        void run(async () => { value(await ctx.remote.chatgpt.complete(pasted)); await status() })
+      } },
+      h('p', null, h('a', { href: url, target: '_blank', rel: 'noopener noreferrer' }, 'Open ChatGPT sign-in')),
+      h('p', null, 'After signing in, the localhost page may fail to load. Copy its full address and paste it here.'),
+      h(Input, { type: 'password', autoComplete: 'off', spellCheck: false, 'aria-label': 'Callback URL',
+        placeholder: 'http://127.0.0.1:1455/auth/callback?…', value: callback,
+        onChange: (event) => setCallback(event.currentTarget.value), style: { width: '100%', padding: 8 } }),
+      h(Button, { variant: 'primary', type: 'submit', disabled: busy || !callback.trim() }, 'Connect'),
+      h(Button, { type: 'button', disabled: busy, onClick: () => {
+        setUrl(''); setCallback(''); void run(async () => { value(await ctx.remote.chatgpt.cancel()) })
+      } }, 'Cancel')),
+      email && h(Button, { disabled: busy, onClick: () => void run(async () => {
+        const revoked = value(await ctx.remote.chatgpt.signOut()); setEmail(''); setUrl(''); setCallback('')
+        if (!revoked) setNotice('Signed out locally. Disconnect DSH Flare in ChatGPT Settings to revoke the remote session.')
+      }) }, 'Sign out'),
+      notice && h('p', { role: 'alert' }, notice),
+      h('p', null, h('a', { href: 'https://chatgpt.com/settings/usage', target: '_blank', rel: 'noopener noreferrer' }, 'ChatGPT usage and app access')),
+    )
+  }
+  ctx.slots.inject('settings.section', () => ctx.slots.register({
+    name: 'settings.section', id: 'chatgpt', order: 15, label: () => 'ChatGPT',
+  }, Account))
+}
