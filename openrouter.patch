diff --git a/packages/experimental/llm-openrouter-browser/src/adapter.ts b/packages/experimental/llm-openrouter-browser/src/adapter.ts
new file mode 100644
index 00000000..b2bd9192
--- /dev/null
+++ b/packages/experimental/llm-openrouter-browser/src/adapter.ts
@@ -0,0 +1,219 @@
+import { createParser } from 'eventsource-parser'
+import { z } from 'zod'
+import { attributionHeaders, LlmAdapter, LlmError, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, GenerateOptions, LlmResolvedModelInfo, StreamChunk, TokenUsage } from '@deepseek-ai/dsh-llm'
+import type { Config } from './index.ts'
+import { parseCatalog } from './catalog.ts'
+
+const detail = z.record(z.string(), z.unknown())
+const replay = z.object({ response: z.object({
+  format: z.literal('openrouter-v1'), model: z.string(), details: z.array(detail),
+}) })
+const frame = z.object({
+  error: z.object({ message: z.string().optional(), code: z.union([z.number(), z.string()]).optional() }).optional(),
+  choices: z.array(z.object({
+    index: z.number().optional(), finish_reason: z.string().nullable().optional(),
+    delta: z.object({
+      content: z.string().nullable().optional(), reasoning: z.string().nullable().optional(),
+      reasoning_details: z.array(detail).optional(),
+      tool_calls: z.array(z.object({
+        index: z.number().int().nonnegative(), id: z.string().optional(),
+        function: z.object({ name: z.string().optional(), arguments: z.string().optional() }).optional(),
+      })).optional(),
+    }).optional(),
+  })).default([]),
+  usage: z.object({
+    prompt_tokens: z.number().nonnegative(), completion_tokens: z.number().nonnegative(),
+    total_tokens: z.number().nonnegative().optional(),
+    prompt_tokens_details: z.object({ cached_tokens: z.number().nonnegative().optional() }).nullish(),
+    completion_tokens_details: z.object({ reasoning_tokens: z.number().nonnegative().optional() }).nullish(),
+  }).nullish(),
+})
+
+function requestBody(options: GenerateOptions): unknown {
+  const messages: Record<string, unknown>[] = []
+  if (options.system) messages.push({ role: 'system', content: options.system })
+  for (const message of options.messages) {
+    const content = message.content.filter(block => block.type === 'text').map(block => block.text).join('\n')
+    if (message.content.some(block => !['text', 'reasoning', 'tool-call'].includes(block.type))) {
+      throw new LlmError('OpenRouter browser adapter expects text-projected content.', 'UNSUPPORTED_CONTENT')
+    }
+    if (message.role === 'tool') {
+      messages.push({ role: 'tool', tool_call_id: message.toolCallId, content })
+    } else if (message.role === 'assistant') {
+      const calls = message.content.filter(block => block.type === 'tool-call').map(block => ({
+        id: block.id, type: 'function', function: { name: block.name, arguments: block.arguments },
+      }))
+      const stored = replay.safeParse(message.source.replayState)
+      messages.push({
+        role: 'assistant', content: content || null,
+        ...calls.length ? { tool_calls: calls } : {},
+        ...stored.success && stored.data.response.model === options.model
+          ? { reasoning_details: stored.data.response.details } : {},
+      })
+    } else {
+      messages.push({ role: message.role === 'developer' ? 'system' : message.role, content })
+    }
+  }
+  return {
+    model: options.model, messages, stream: true, stream_options: { include_usage: true },
+    ...options.tools?.length ? { tools: options.tools.map(tool => ({
+      type: 'function', function: { name: tool.name, description: tool.description, parameters: tool.parameters },
+    })) } : {},
+    ...options.maxTokens === undefined ? {} : { max_tokens: options.maxTokens },
+    ...options.temperature === undefined ? {} : { temperature: options.temperature },
+    ...options.stop === undefined ? {} : { stop: options.stop },
+  }
+}
+
+export class OpenRouterAdapter extends LlmAdapter {
+  private catalog: { at: number; models: LlmResolvedModelInfo[] } | undefined
+
+  constructor(private readonly config: Config, private readonly key: () => Promise<string>, private readonly lifetime: AbortSignal) {
+    super()
+  }
+
+  override providerInfo(provider: string): { id: string; name: string } {
+    return { id: provider, name: 'OpenRouter' }
+  }
+
+  override async listModels(_provider: string): Promise<readonly LlmResolvedModelInfo[]> {
+    if (this.catalog && Date.now() - this.catalog.at < this.config.catalogTtlMs) return this.catalog.models
+    const response = await fetch(`${this.config.baseURL.replace(/\/$/, '')}/models`, {
+      signal: AbortSignal.any([this.lifetime, AbortSignal.timeout(this.config.requestTimeoutMs)]),
+      credentials: 'omit', redirect: 'error', cache: 'no-store',
+    })
+    if (!response.ok) throw new LlmError(`OpenRouter catalog returned HTTP ${response.status}.`, 'CATALOG_ERROR', { status: response.status })
+    const models = parseCatalog(await response.json(), this.config.provider)
+    this.catalog = { at: Date.now(), models }
+    return models
+  }
+
+  override async resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    const found = (await this.listModels(provider)).find(item => item.id === model)
+    if (!found) throw new LlmError(`OpenRouter has no tool-capable model named ${model}.`, 'MODEL_NOT_FOUND')
+    return found
+  }
+
+  override async* stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    const controller = new AbortController()
+    const signal = AbortSignal.any([
+      this.lifetime, controller.signal, AbortSignal.timeout(this.config.requestTimeoutMs),
+      ...options.signal === undefined ? [] : [options.signal],
+    ])
+    let reader: ReadableStreamDefaultReader<Uint8Array> | undefined
+    try {
+      const apiKey = await this.key()
+      signal.throwIfAborted()
+      const response = await fetch(`${this.config.baseURL.replace(/\/$/, '')}/chat/completions`, {
+        method: 'POST', signal, credentials: 'omit', redirect: 'error', cache: 'no-store',
+        headers: { ...attributionHeaders(), Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json', 'X-OpenRouter-Title': 'DSH Flare' },
+        body: JSON.stringify(requestBody(options)),
+      })
+      if (!response.ok) {
+        await response.body?.cancel()
+        throw new LlmError(`OpenRouter returned HTTP ${response.status}. Check your API key, credit, and model access.`,
+          'PROVIDER_ERROR', { status: response.status })
+      }
+      if (!response.body || !response.headers.get('content-type')?.includes('text/event-stream')) {
+        await response.body?.cancel()
+        throw new LlmError('OpenRouter did not return an event stream.', 'INVALID_RESPONSE')
+      }
+      reader = response.body.getReader()
+      const decoder = new TextDecoder()
+      const blocks: ContentBlock[] = []
+      const slots = new Map<string, number>()
+      const toolSlots = new Map<number, { index: number; id: string; name: string; arguments: string; emitted: number }>()
+      const details = new Map<number, Record<string, unknown>>()
+      const events: string[] = []
+      let finish: string | undefined
+      let done = false
+      let usage: TokenUsage | undefined
+      const parser = createParser({ onEvent: event => events.push(event.data) })
+      while (!done) {
+        const read = await reader.read()
+        parser.feed(decoder.decode(read.value, { stream: !read.done }))
+        if (read.done) parser.reset({ consume: true })
+        for (const event of events.splice(0)) {
+          if (event === '[DONE]') { done = true; break }
+          const value = frame.parse(JSON.parse(event))
+          if (value.error) throw new LlmError(value.error.message ?? 'OpenRouter stream failed.', 'PROVIDER_ERROR')
+          if (value.usage) {
+            const cached = value.usage.prompt_tokens_details?.cached_tokens ?? 0
+            usage = {
+              inputTokens: Math.max(0, value.usage.prompt_tokens - cached), outputTokens: value.usage.completion_tokens,
+              cacheReadTokens: cached,
+              ...value.usage.total_tokens === undefined ? {} : { totalTokens: value.usage.total_tokens },
+              ...value.usage.completion_tokens_details?.reasoning_tokens === undefined
+                ? {} : { reasoningTokens: value.usage.completion_tokens_details.reasoning_tokens },
+            }
+          }
+          for (const choice of value.choices) {
+            if (choice.index !== undefined && choice.index !== 0) continue
+            if (choice.finish_reason) finish = choice.finish_reason
+            const delta = choice.delta
+            if (!delta) continue
+            for (const [type, text] of [['reasoning', delta.reasoning], ['text', delta.content]] as const) {
+              if (!text) continue
+              let index = slots.get(type)
+              if (index === undefined) {
+                index = blocks.length
+                slots.set(type, index)
+                blocks.push({ type, text: '' })
+                yield { type: 'block-start', index, blockType: type }
+              }
+              const block = blocks[index]
+              if (block?.type === 'text' || block?.type === 'reasoning') block.text += text
+              yield { type: type === 'text' ? 'text-delta' : 'reasoning-delta', index, text }
+            }
+            for (const [position, part] of (delta.reasoning_details ?? []).entries()) {
+              const index = typeof part.index === 'number' ? part.index : position
+              const previous = details.get(index) ?? {}
+              for (const [field, value] of Object.entries(part)) {
+                previous[field] = ['text', 'data', 'signature', 'summary'].includes(field)
+                  && typeof previous[field] === 'string' && typeof value === 'string' ? previous[field] + value : value
+              }
+              details.set(index, previous)
+            }
+            for (const call of delta.tool_calls ?? []) {
+              let tool = toolSlots.get(call.index)
+              if (!tool) {
+                tool = { index: blocks.length, id: '', name: '', arguments: '', emitted: 0 }
+                toolSlots.set(call.index, tool)
+                blocks.push({ type: 'tool-call', id: ToolCallId(''), name: '', arguments: '' })
+                yield { type: 'block-start', index: tool.index, blockType: 'tool-call' }
+              }
+              if (call.id) tool.id = call.id
+              if (call.function?.name) tool.name += call.function.name
+              tool.arguments += call.function?.arguments ?? ''
+              if (tool.id) {
+                yield { type: 'tool-call-delta', index: tool.index, id: ToolCallId(tool.id),
+                  ...tool.name ? { name: tool.name } : {}, argumentsDelta: tool.arguments.slice(tool.emitted) }
+                tool.emitted = tool.arguments.length
+              }
+              blocks[tool.index] = { type: 'tool-call', id: ToolCallId(tool.id), name: tool.name, arguments: tool.arguments }
+            }
+          }
+        }
+        if (read.done) break
+      }
+      if (!done || !finish) throw new LlmError('OpenRouter stream ended before completion.', 'TRUNCATED_STREAM')
+      if (!['stop', 'tool_calls', 'length'].includes(finish)) throw new LlmError(`OpenRouter stopped with ${finish}.`, 'PROVIDER_ERROR')
+      for (const tool of toolSlots.values()) {
+        if (!tool.id || !tool.name) throw new LlmError('OpenRouter returned an incomplete tool call.', 'INVALID_RESPONSE')
+      }
+      for (const [index, block] of blocks.entries()) yield { type: 'block-end', index, block }
+      if (usage) yield { type: 'usage', usage }
+      yield {
+        type: 'finish', reason: { kind: finish === 'tool_calls' ? 'tool-calls' : finish === 'length' ? 'max-tokens' : 'stop' },
+        replayState: { response: { format: 'openrouter-v1', model: options.model, details: [...details.values()] } },
+      }
+    } finally {
+      controller.abort()
+      if (reader) {
+        await reader.cancel().catch(() => { /* Aborted fetch readers can already be errored. */ })
+        reader.releaseLock()
+      }
+    }
+  }
+}
diff --git a/packages/experimental/llm-openrouter-browser/src/catalog.ts b/packages/experimental/llm-openrouter-browser/src/catalog.ts
new file mode 100644
index 00000000..246d27a9
--- /dev/null
+++ b/packages/experimental/llm-openrouter-browser/src/catalog.ts
@@ -0,0 +1,29 @@
+import { z } from 'zod'
+import type { LlmResolvedModelInfo } from '@deepseek-ai/dsh-llm'
+
+const model = z.object({
+  id: z.string().min(1), name: z.string(), context_length: z.number().int().positive(),
+  supported_parameters: z.array(z.string()).default([]),
+  architecture: z.object({ input_modalities: z.array(z.string()) }).optional(),
+  top_provider: z.object({ max_completion_tokens: z.number().int().positive().nullable() }).optional(),
+  pricing: z.object({ prompt: z.string(), completion: z.string() }),
+})
+
+export function parseCatalog(value: unknown, provider: string): LlmResolvedModelInfo[] {
+  const parsed = z.object({ data: z.array(model) }).parse(value)
+  const price = (raw: string): string => {
+    const number = Number(raw)
+    return Number.isFinite(number) && number >= 0 ? `$${(number * 1_000_000).toLocaleString('en-US', { maximumFractionDigits: 4 })}` : 'unknown'
+  }
+  return parsed.data.filter(item => item.supported_parameters.includes('tools')
+    && (item.architecture === undefined || item.architecture.input_modalities.includes('text')))
+    .map(item => ({
+      provider, id: item.id, name: item.name,
+      inputModalities: ['text'] as const,
+      context: { contextWindow: item.context_length },
+      ...item.top_provider?.max_completion_tokens == null ? {} : { defaultMaxTokens: item.top_provider.max_completion_tokens },
+      description: `${item.id} · Context ${item.context_length.toLocaleString('en-US')}`
+        + ` · Output ${item.top_provider?.max_completion_tokens?.toLocaleString('en-US') ?? 'not reported'}`
+        + ` · Input ${price(item.pricing.prompt)} / output ${price(item.pricing.completion)} per 1M tokens`,
+    })).sort((left, right) => left.id.localeCompare(right.id))
+}
diff --git a/packages/experimental/llm-openrouter-browser/src/index.ts b/packages/experimental/llm-openrouter-browser/src/index.ts
new file mode 100644
index 00000000..83b97197
--- /dev/null
+++ b/packages/experimental/llm-openrouter-browser/src/index.ts
@@ -0,0 +1,51 @@
+import type { Context, Volatile } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/cordis-plugin-loader'
+import z from '@deepseek-ai/schemastery'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import type {} from '@deepseek-ai/dsh-settings'
+import { assertUsableApiKey, LlmError } from '@deepseek-ai/dsh-llm'
+import { OpenRouterAdapter } from './adapter.ts'
+
+export const name = 'llm-openrouter-browser'
+export const inject = ['llm', 'credentials']
+
+export interface Config {
+    provider: string
+    apiKeyEnv: Volatile<string>
+    baseURL: string
+    catalogTtlMs: number
+    requestTimeoutMs: number
+}
+
+export const Config = z.object({
+  provider: z.string().default('openrouter-browser'),
+  apiKeyEnv: z.string().role('credential-ref').default('OPENROUTER_API_KEY').volatile(),
+  baseURL: z.string().default('https://openrouter.ai/api/v1'),
+  catalogTtlMs: z.number().min(0).default(300_000),
+  requestTimeoutMs: z.number().min(1).max(2_147_483_647).default(300_000),
+})
+
+export function apply(ctx: Context, config: Config): void {
+  if (!config.provider.trim()) throw new Error('OpenRouter provider route must not be empty')
+  const ref = credentialRef(config.apiKeyEnv.get())
+  const endpoint = new URL(config.baseURL)
+  if (endpoint.username || endpoint.password || endpoint.search || endpoint.hash
+    || (endpoint.protocol !== 'https:' && endpoint.hostname !== 'localhost' && endpoint.hostname !== '127.0.0.1')) {
+    throw new Error('OpenRouter requires an HTTPS baseURL without credentials, query, or fragment')
+  }
+  const lifetime = new AbortController()
+  ctx.effect(() => () => { lifetime.abort() })
+  const adapter = new OpenRouterAdapter(config, async () => {
+    const currentRef = credentialRef(config.apiKeyEnv.get())
+    const key = (await ctx.credentials.resolve(currentRef))?.value
+    if (!key) throw new LlmError('Add your OpenRouter API key in Settings → Models.', 'MISSING_CREDENTIAL')
+    return assertUsableApiKey(key, name, currentRef)
+  }, lifetime.signal)
+  ctx.llm.registerAdapter([config.provider], adapter)
+  ctx.inject(['settings'], (child) => { child.effect(() => child.settings.configure({ auto: false }, ctx.fiber)) })
+  ctx.llm.registerConfigurableProviders([{
+    provider: config.provider, displayName: 'OpenRouter',
+    settingsNs: ctx.fiber.entry?.options.id ?? name, settingsPath: [], declared: false,
+    defaultBaseURL: config.baseURL, nativeAuth: { env: [ref], oauth: false },
+  }])
+}
