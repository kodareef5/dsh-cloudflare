diff --git a/packages/experimental/credentials-memory/src/index.ts b/packages/experimental/credentials-memory/src/index.ts
new file mode 100644
index 00000000..a2ef8adc
--- /dev/null
+++ b/packages/experimental/credentials-memory/src/index.ts
@@ -0,0 +1,90 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { CredentialProvider } from '@deepseek-ai/dsh-credentials'
+import type {
+  CredentialInfo, CredentialKey, CredentialRecord, CredentialRecordEntry,
+  CredentialRecordInfo, CredentialRef, ResolvedCredential,
+} from '@deepseek-ai/dsh-credentials'
+
+export default class MemoryCredentials extends CredentialProvider {
+  private readonly values = new Map<CredentialRef, string>()
+  private readonly records = new Map<CredentialKey, CredentialRecord>()
+  private pending: Promise<unknown> = Promise.resolve()
+  private disposed = false
+
+  constructor(ctx: Context) {
+    super(ctx)
+    ctx.effect(() => () => {
+      this.disposed = true
+      this.values.clear()
+      this.records.clear()
+    })
+  }
+
+  private assertActive(): void {
+    if (this.disposed) throw new Error('Memory credentials have been disposed')
+  }
+
+  override async resolve(ref: CredentialRef): Promise<ResolvedCredential | undefined> {
+    this.assertActive()
+    const value = this.values.get(ref)
+    return value === undefined ? undefined : { value, source: 'memory' }
+  }
+
+  override async describe(ref: CredentialRef): Promise<CredentialInfo> {
+    const resolved = await this.resolve(ref)
+    return { configured: resolved !== undefined, writable: true, ...resolved === undefined ? {} : { source: 'memory' } }
+  }
+
+  override async set(ref: CredentialRef, value: string): Promise<void> {
+    this.assertActive()
+    if (!value.trim()) throw new Error('Empty credential; use unset to remove it')
+    this.values.set(ref, value)
+    this.notifyUpdated(ref)
+  }
+
+  override async unset(ref: CredentialRef): Promise<void> {
+    this.assertActive()
+    if (this.values.delete(ref)) this.notifyUpdated(ref)
+  }
+
+  override async readRecord(key: CredentialKey): Promise<CredentialRecord | undefined> {
+    this.assertActive()
+    return structuredClone(this.records.get(key))
+  }
+
+  override async describeRecord(key: CredentialKey): Promise<CredentialRecordInfo> {
+    const record = await this.readRecord(key)
+    return { configured: record !== undefined, writable: true, ...record === undefined ? {} : { kind: record.kind } }
+  }
+
+  override async listRecords(): Promise<readonly CredentialRecordEntry[]> {
+    this.assertActive()
+    return [...this.records].map(([key, record]) => ({ key, kind: record.kind }))
+  }
+
+  override modifyRecord(
+    key: CredentialKey,
+    mutate: (current: CredentialRecord | undefined) => Promise<CredentialRecord | undefined>,
+  ): Promise<CredentialRecord | undefined> {
+    const operation = this.pending.then(async () => {
+      const current = await this.readRecord(key)
+      const next = await mutate(current)
+      this.assertActive()
+      if (next === undefined) return current
+      this.records.set(key, structuredClone(next))
+      this.notifyRecordUpdated(key)
+      return structuredClone(next)
+    })
+    this.pending = operation.catch(() => { /* A failed mutation must not block later writes. */ })
+    return operation
+  }
+
+  override async deleteRecord(key: CredentialKey): Promise<void> {
+    const operation = this.pending.then(() => {
+      this.assertActive()
+      if (this.records.delete(key)) this.notifyRecordUpdated(key)
+    })
+    this.pending = operation.catch(() => { /* The caller receives the failure; the queue remains usable. */ })
+    await operation
+  }
+}
