diff --git a/packages/experimental/webworker-runtime/src/shell/programs/git.ts b/packages/experimental/webworker-runtime/src/shell/programs/git.ts
new file mode 100644
index 00000000..89107f11
--- /dev/null
+++ b/packages/experimental/webworker-runtime/src/shell/programs/git.ts
@@ -0,0 +1,104 @@
+import { clone } from 'isomorphic-git'
+import http from 'isomorphic-git/http/web'
+import { filesystemError, resolveIn } from '../fs-access.ts'
+import type { ShellProgram } from '../types.ts'
+
+/** A shallow public GitHub clone into the browser filesystem. */
+export const git: ShellProgram = async (argv, io, state, fs) => {
+  const args = [...argv.slice(1)]
+  let cwd = state.cwd
+  while (args[0] === '-C' && args[1]) { args.shift(); cwd = resolveIn(cwd, args.shift()!) }
+  if (args.shift() !== 'clone') throw new Error('This browser supports git clone of public GitHub repositories')
+  let ref: string | undefined
+  let depth = 1
+  const positional: string[] = []
+  while (args.length) {
+    const arg = args.shift()!
+    if (arg === '--') { positional.push(...args); break }
+    if (arg === '--depth') depth = Number(args.shift())
+    else if (arg.startsWith('--depth=')) depth = Number(arg.slice(8))
+    else if (arg === '-b' || arg === '--branch') {
+      ref = args.shift()
+      if (!ref || ref.startsWith('-')) throw new Error('A branch name is required')
+    }
+    else if (arg.startsWith('--branch=')) ref = arg.slice(9)
+    else if (['--single-branch', '--no-tags', '-q', '--quiet'].includes(arg)) continue
+    else if (arg.startsWith('-')) throw new Error(`Unsupported clone option: ${arg}`)
+    else positional.push(arg)
+  }
+  if (!Number.isInteger(depth) || depth < 1 || depth > 100) throw new Error('Clone depth must be between 1 and 100')
+  if (positional.length < 1 || positional.length > 2) throw new Error('Usage: git clone [--depth N] [-b branch] https://github.com/owner/repo [directory]')
+  const match = /^https:\/\/github\.com\/([\w.-]+)\/([\w.-]+?)\/?$/.exec(positional[0]!)
+  if (!match) throw new Error('Use a public https://github.com/owner/repo URL')
+  const name = match[2]!.replace(/\.git$/, '')
+  const url = `https://github.com/${match[1]}/${name}.git`
+  const dir = resolveIn(cwd, positional[1] ?? name)
+  if (await fs.stat(dir)) throw new Error(`Destination already exists: ${dir}`)
+  const staging = `${dir}.clone-${crypto.randomUUID()}`
+  const signal = state.signal
+  const check = (): void => { signal?.throwIfAborted() }
+  const stat = async (path: string) => {
+    check()
+    const value = await fs.stat(path)
+    if (!value) throw filesystemError('ENOENT', 'stat', path)
+    return {
+      ...value, mode: value.directory ? 0o040755 : 0o100644,
+      mtime: new Date(value.mtimeMs), ctime: new Date(value.mtimeMs), ctimeMs: value.mtimeMs,
+      dev: 0, ino: 0, uid: 0, gid: 0,
+      isDirectory: () => value.directory, isFile: () => !value.directory, isSymbolicLink: () => false,
+    }
+  }
+  const promises = {
+    stat, lstat: stat,
+    readFile: async (path: string, encoding?: string | { encoding?: string }) => {
+      check()
+      return encoding === 'utf8' || (typeof encoding === 'object' && encoding.encoding === 'utf8')
+        ? await fs.readText(path) : await fs.readBytes(path)
+    },
+    writeFile: async (path: string, data: string | Uint8Array) => {
+      check()
+      await fs.writeBytes(path, typeof data === 'string' ? new TextEncoder().encode(data) : data)
+    },
+    readdir: async (path: string) => { check(); return (await fs.list(path)).map(entry => entry.name) },
+    mkdir: async (path: string) => { check(); await fs.mkdir(path, false) },
+    rmdir: async (path: string) => { check(); await fs.remove(path, { recursive: false, force: false }) },
+    unlink: async (path: string) => { check(); await fs.remove(path, { recursive: false, force: false }) },
+    readlink: async (path: string) => await fs.readText(path),
+    symlink: async (target: string, path: string) => {
+      check()
+      io.err(`Symlink stored as link text: ${path.slice(staging.length + 1)}\n`)
+      await fs.writeText(path, target)
+    },
+  }
+  const transport: typeof http = {
+    async request(input) {
+      check()
+      const response = await http.request({
+        ...input, url: `${globalThis.location.origin}/fetch?url=${encodeURIComponent(input.url)}`,
+        headers: { 'x-dsh-fetch': '1' }, signal,
+      })
+      if (response.statusCode !== 200) throw new Error(`GitHub download failed (HTTP ${response.statusCode})`)
+      const statusCode = Number(response.headers?.['x-dsh-status'])
+      if (!Number.isInteger(statusCode) || statusCode < 100 || statusCode > 599) {
+        throw new Error('The Cloudflare fetch route is unavailable')
+      }
+      return {
+        ...response, url: input.url, statusCode,
+        headers: { 'content-type': response.headers?.['x-dsh-content-type'] ?? '' },
+      }
+    },
+  }
+  io.err(`Cloning into '${positional[1] ?? name}' (depth ${depth})...\n`)
+  await fs.mkdir(staging, false)
+  try {
+    await clone({ fs: { promises }, http: transport, dir: staging, url, depth, ref, singleBranch: true, noTags: true })
+    check()
+    if (await fs.stat(dir)) throw new Error(`Destination already exists: ${dir}`)
+    await fs.rename(staging, dir)
+  } catch (error) {
+    await fs.remove(staging, { recursive: true, force: true })
+    throw error
+  }
+  io.out(`Cloned ${url} into ${dir}\n`)
+  return 0
+}
