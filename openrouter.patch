+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { credentialKey } from '@deepseek-ai/dsh-credentials'
+import { exportJWK, generateKeyPair, SignJWT } from 'jose'
+import MemoryCredentials from '../../credentials-memory/src/index.ts'
+import { ChatGPTAuth } from '../src/auth.ts'
+import { ChatGPTAdapter, requestBody } from '../src/adapter.ts'
+import type { GenerateOptions, StreamChunk } from '@deepseek-ai/dsh-llm'
+
+let ctx: Context
+let auth: ChatGPTAuth
+let lifetime: AbortController
+const host = `urn:uuid:${crypto.randomUUID()}`
+const key = credentialKey('llm-chatgpt-browser', 'chatgpt')
+const options: GenerateOptions = { provider: 'chatgpt', model: 'test-model', messages: [] }
+let requests: { route: string; init: RequestInit }[]
+let signIn: URL
+let claims: Record<string, unknown>
+let expires: number
+let extraScopes: string
+let refreshes: number
+let respond: () => Response
+let tamperSignature: boolean
+
+beforeEach(async () => {
+  ctx = new Context()
+  await ctx.plugin(MemoryCredentials)
+  lifetime = new AbortController()
+  auth = new ChatGPTAuth(ctx, lifetime.signal)
+  requests = []; claims = {}; expires = 3600; extraScopes = 'chatgpt.tokens.use.direct'; refreshes = 0
+  tamperSignature = false
+  respond = () => new Response('unused', { status: 500 })
+  vi.stubGlobal('location', { origin: 'https://flare.example' })
+  const { publicKey, privateKey } = await generateKeyPair('RS256')
+  const jwk = await exportJWK(publicKey)
+  vi.stubGlobal('fetch', vi.fn(async (url: string, init: RequestInit = {}) => {
+    init.signal?.throwIfAborted()
+    const route = new URL(url).pathname
+    requests.push({ route, init })
+    if (route === '/openai/jwks') return Response.json({ keys: [{ ...jwk, kid: 'test', alg: 'RS256', use: 'sig' }] })
+    if (route === '/openai/token') {
+      const form = new URLSearchParams(String(init.body))
+      const refresh = form.get('grant_type') === 'refresh_token'
+      if (refresh) refreshes++
+      else expect(form.get('code_verifier')).toHaveLength(43)
+      const id = await new SignJWT({ nonce: signIn.searchParams.get('nonce'), email: 'test@example.com', ...claims })
+        .setProtectedHeader({ alg: 'RS256', kid: 'test' }).setIssuer('https://auth.openai.com')
+        .setAudience('oaiapp_test').setSubject('user-test').setExpirationTime('1h').sign(privateKey)
+      return Response.json({ access_token: refresh ? 'new-access' : 'test-access', refresh_token: refresh ? 'new-refresh' : 'test-refresh',
+        id_token: tamperSignature ? id.slice(0, id.lastIndexOf('.') + 1) + 'invalid' : id,
+        token_type: 'Bearer', expires_in: refresh ? 3600 : expires, scope: extraScopes })
+    }
+    if (route === '/openai/revoke') return new Response('')
+    if (route === '/openai/models') return Response.json({ models: [
+      { slug: 'hidden', display_name: 'Hidden', visibility: 'hidden' },
+      { slug: 'test-model', display_name: 'Test model', visibility: 'list', context_window: 128000 },
+    ] })
+    if (route === '/openai/responses') return respond()
+    throw new Error(`Unexpected mock route ${route}`)
+  }))
+})
+afterEach(async () => { try { lifetime.abort(); auth.cancel(); await ctx.fiber.dispose() } finally { vi.unstubAllGlobals() } })
+
+async function callback(): Promise<URL> {
+  signIn = new URL(await auth.begin(host))
+  return new URL(`http://127.0.0.1:1455/auth/callback?${new URLSearchParams({ code: 'one-use-code', state: signIn.searchParams.get('state')!, client_id: 'oaiapp_test' })}`)
+}
+async function connect(): Promise<void> { await auth.complete((await callback()).href) }
+async function collect(): Promise<StreamChunk[]> {
+  const chunks: StreamChunk[] = []
+  for await (const chunk of new ChatGPTAdapter(auth).stream(options)) chunks.push(chunk)
+  return chunks
+}
+function sse(events: object[]): Response {
+  return new Response(events.map(event => `data: ${JSON.stringify(event)}\n\n`).join(''), { headers: { 'content-type': 'text/event-stream' } })
+}
+
+it('uses PKCE, validates identity, keeps tokens out of public status, and consumes callbacks once', async () => {
+  const url = await callback()
+  expect(signIn.searchParams.get('agent_name_hint')).toBe('DSH Flare')
+  expect(signIn.searchParams.get('code_challenge_method')).toBe('S256')
+  await auth.complete(url.href)
+  const tokenRequest = requests.find(request => request.route === '/openai/token')!
+  const verifier = new URLSearchParams(String(tokenRequest.init.body)).get('code_verifier')!
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)))
+  expect(Buffer.from(digest).toString('base64url')).toBe(signIn.searchParams.get('code_challenge'))
+  expect(await auth.status()).toEqual({ connected: true, email: 'test@example.com' })
+  expect(await auth.accessToken()).toBe('test-access')
+  await expect(auth.complete(url.href)).rejects.toThrow('expired')
+  expect(requests.filter(request => request.route === '/openai/token')).toHaveLength(1)
+})
+
+it.each(['state', 'origin', 'client_id', 'duplicate'])('rejects a forged %s before exchanging a code', async field => {
+  const url = await callback()
+  if (field === 'state') url.searchParams.set('state', 'wrong')
+  if (field === 'origin') url.hostname = 'example.com'
+  if (field === 'client_id') url.searchParams.delete('client_id')
+  if (field === 'duplicate') url.searchParams.append('code', 'other')
+  await expect(auth.complete(url.href)).rejects.toThrow()
+  expect(requests).toHaveLength(0)
+  expect((await auth.status()).connected).toBe(false)
+})
+
+it('rejects an ID token with the wrong nonce without saving credentials', async () => {
+  claims = { nonce: 'wrong' }
+  await expect(connect()).rejects.toThrow('identity')
+  expect((await auth.status()).connected).toBe(false)
+})
+
+it('rejects identity-only authorization', async () => {
+  extraScopes = 'openid email'
+  await expect(connect()).rejects.toThrow('plan usage')
+  expect((await auth.status()).connected).toBe(false)
+})
+
+it('rejects an invalid ID-token signature', async () => {
+  tamperSignature = true
+  await expect(connect()).rejects.toThrow()
+  expect((await auth.status()).connected).toBe(false)
+})
+
+it('cannot commit a grant after cancellation during verification', async () => {
+  const url = await callback()
+  const fetchToken = globalThis.fetch
+  vi.stubGlobal('fetch', vi.fn(async (...args: Parameters<typeof fetch>) => {
+    const response = await fetchToken(...args)
+    if (String(args[0]).endsWith('/jwks')) auth.cancel()
+    return response
+  }))
+  await expect(auth.complete(url.href)).rejects.toThrow()
+  expect((await auth.status()).connected).toBe(false)
+})
+
+it('withdraws a cancelled attempt and supersedes older attempts', async () => {
+  const first = await callback()
+  auth.cancel()
+  await expect(auth.complete(first.href)).rejects.toThrow('expired')
+  await callback()
+  await expect(auth.complete(first.href)).rejects.toThrow('match')
+  expect(requests).toHaveLength(0)
+})
+
+it('serializes refresh and revokes the rotated refresh token on sign-out', async () => {
+  expires = 1
+  await connect()
+  expect(await Promise.all([auth.accessToken(), auth.accessToken(), auth.accessToken()])).toEqual(['new-access', 'new-access', 'new-access'])
+  expect(refreshes).toBe(1)
+  expect(await auth.signOut()).toBe(true)
+  const revoked = requests.find(request => request.route === '/openai/revoke')!
+  expect(new URLSearchParams(String(revoked.init.body)).get('token')).toBe('new-refresh')
+  expect(await ctx.credentials.readRecord(key)).toBeUndefined()
+  const returning = new URL(await auth.begin(host))
+  expect(returning.searchParams.get('client_id')).toBe('oaiapp_test')
+  expect(returning.searchParams.has('agent_name_hint')).toBe(false)
+})
+
+it('only lists models visible to the signed-in account', async () => {
+  const adapter = new ChatGPTAdapter(auth)
+  expect(await adapter.listModels('chatgpt')).toEqual([])
+  await connect()
+  expect((await adapter.listModels('chatgpt')).map(model => model.id)).toEqual(['test-model'])
+})
+
+it('omits unsupported parameters and groups tools in a namespace', () => {
+  const body = requestBody({ ...options, system: 'Be helpful', maxTokens: 100, temperature: 0.5,
+    tools: [{ name: 'read', description: 'Read a file', parameters: { type: 'object', properties: {} } }] })
+  expect(body).toMatchObject({ stream: true, store: false, instructions: 'Be helpful', tools: [{ type: 'namespace', name: 'dsh' }] })
+  expect(body).not.toHaveProperty('temperature')
+  expect(body).not.toHaveProperty('max_output_tokens')
+})
+
+it('streams namespaced tool calls, reports usage, and preserves completed replay items', async () => {
+  await connect()
+  const item = { type: 'function_call', id: 'fc_1', call_id: 'call_1', name: 'read', namespace: 'dsh', arguments: '{"path":"README"}' }
+  respond = () => sse([
+    { type: 'response.output_item.added', output_index: 0, item: { ...item, arguments: '' } },
+    { type: 'response.function_call_arguments.delta', output_index: 0, delta: item.arguments },
+    { type: 'response.output_item.done', output_index: 0, item },
+    { type: 'response.completed', response: { output: [item], usage: { input_tokens: 10, output_tokens: 3, input_tokens_details: { cached_tokens: 4 } } } },
+  ])
+  const chunks = await collect()
+  expect(chunks).toContainEqual({ type: 'tool-call-delta', index: 0, id: 'call_1', argumentsDelta: item.arguments })
+  expect(chunks).toContainEqual({ type: 'usage', usage: { inputTokens: 6, outputTokens: 3, cacheReadTokens: 4 } })
+  expect(chunks.at(-1)).toMatchObject({ type: 'finish', reason: { kind: 'tool-calls' }, replayState: { blocks: [{ item }] } })
+})
+
+it.each(['truncated', 'response.failed', 'response.incomplete'])('does not report success for %s streams', async event => {
+  await connect()
+  respond = () => sse(event === 'truncated' ? [] : [{ type: event, response: { error: { code: 'subscription_sharing_usage_limit_exceeded' } } }])
+  await expect(collect()).rejects.toThrow()
+})
