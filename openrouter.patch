diff --git a/packages/experimental/llm-chatgpt-browser/src/adapter.ts b/packages/experimental/llm-chatgpt-browser/src/adapter.ts
new file mode 100644
index 00000000..91e00f8f
--- /dev/null
+++ b/packages/experimental/llm-chatgpt-browser/src/adapter.ts
@@ -0,0 +1,170 @@
+import { createParser } from 'eventsource-parser'
+import { z } from 'zod'
+import { LlmAdapter, LlmError, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { ContentBlock, GenerateOptions, LlmResolvedModelInfo, StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { ChatGPTAuth } from './auth.ts'
+
+const object = z.record(z.string(), z.unknown())
+const replay = z.object({ response: z.object({ format: z.literal('chatgpt-responses'), model: z.string() }),
+  blocks: z.array(z.object({ item: object })) })
+const itemSchema = z.discriminatedUnion('type', [
+  z.object({ type: z.literal('message'), content: z.array(z.object({ type: z.string(), text: z.string().optional(), refusal: z.string().optional() })) }).passthrough(),
+  z.object({ type: z.literal('reasoning'), summary: z.array(z.object({ text: z.string() })).default([]) }).passthrough(),
+  z.object({ type: z.literal('function_call'), call_id: z.string().min(1), name: z.string().min(1), arguments: z.string(), namespace: z.string().optional() }).passthrough(),
+])
+const usageSchema = z.object({ input_tokens: z.number(), output_tokens: z.number(), total_tokens: z.number().optional(),
+  input_tokens_details: z.object({ cached_tokens: z.number().optional() }).nullish(),
+  output_tokens_details: z.object({ reasoning_tokens: z.number().optional() }).nullish() })
+const eventSchema = z.object({
+  type: z.string(), output_index: z.number().int().nonnegative().optional(), delta: z.string().optional(),
+  item: object.optional(), response: z.object({ output: z.array(object).optional(), usage: usageSchema.nullish(),
+    error: z.object({ code: z.string() }).nullish() }).optional(),
+})
+
+function content(item: z.infer<typeof itemSchema>): ContentBlock {
+  switch (item.type) {
+    case 'message': return { type: 'text', text: item.content.map(part => part.text ?? part.refusal ?? '').join('') }
+    case 'reasoning': return { type: 'reasoning', text: item.summary.map(part => part.text).join('\n') }
+    case 'function_call':
+      if (item.namespace !== undefined && item.namespace !== 'dsh') throw new LlmError('Unknown tool namespace', 'INVALID_RESPONSE')
+      return { type: 'tool-call', id: ToolCallId(item.call_id), name: item.name, arguments: item.arguments }
+  }
+}
+
+/** Full history on every request; encrypted reasoning follows its retained block. */
+export function requestBody(options: GenerateOptions): unknown {
+  const input: Record<string, unknown>[] = []
+  for (const message of options.messages) {
+    if (message.content.some(block => !['text', 'reasoning', 'tool-call'].includes(block.type))) {
+      throw new LlmError('The ChatGPT browser adapter currently accepts text and tool results.', 'UNSUPPORTED_CONTENT')
+    }
+    const text = message.content.filter(block => block.type === 'text').map(block => block.text).join('\n')
+    if (message.role === 'tool') input.push({ type: 'function_call_output', call_id: message.toolCallId, output: text })
+    else if (message.role === 'assistant') {
+      const stored = replay.safeParse(message.source.replayState)
+      if (stored.success && stored.data.response.model === options.model && stored.data.blocks.length === message.content.length) {
+        input.push(...stored.data.blocks.map(block => block.item))
+      } else for (const block of message.content) {
+        if (block.type === 'text' && block.text) input.push({ role: 'assistant', content: block.text })
+        if (block.type === 'tool-call') input.push({ type: 'function_call', namespace: 'dsh', call_id: block.id, name: block.name, arguments: block.arguments })
+      }
+    } else input.push({ role: message.role === 'system' ? 'developer' : message.role, content: text })
+  }
+  return { model: options.model, store: false, stream: true, input,
+    ...options.system ? { instructions: options.system } : {},
+    include: ['reasoning.encrypted_content'],
+    ...options.tools?.length ? { tools: [{ type: 'namespace', name: 'dsh', description: 'Browser workspace tools',
+      tools: options.tools.map(tool => ({ type: 'function', name: tool.name, description: tool.description,
+        parameters: tool.parameters, strict: false })) }] } : {},
+  }
+}
+
+export class ChatGPTAdapter extends LlmAdapter {
+  constructor(private readonly auth: ChatGPTAuth) { super() }
+  override providerInfo(provider: string): { id: string; name: string } { return { id: provider, name: 'ChatGPT subscription' } }
+
+  override async listModels(provider: string): Promise<readonly LlmResolvedModelInfo[]> {
+    if (!(await this.auth.status()).connected) return []
+    const token = await this.auth.accessToken()
+    const response = await this.auth.request('models', { headers: { authorization: `Bearer ${token}` } })
+    if (!response.ok) { await response.body?.cancel(); throw new LlmError(`ChatGPT models returned HTTP ${response.status}. Sign in again.`, 'CATALOG_ERROR') }
+    const catalog = z.object({ models: z.array(z.object({
+      slug: z.string(), display_name: z.string(), visibility: z.string(), context_window: z.number().positive().optional(),
+    })) }).parse(await response.json())
+    return catalog.models.filter(model => model.visibility === 'list').map(model => ({
+      provider, id: model.slug, name: model.display_name, inputModalities: ['text'] as const,
+      description: 'Uses your ChatGPT plan allowance',
+      ...model.context_window === undefined ? {} : { context: { contextWindow: model.context_window } },
+    }))
+  }
+
+  override async resolveModel(provider: string, model: string): Promise<LlmResolvedModelInfo> {
+    const found = (await this.listModels(provider)).find(item => item.id === model)
+    if (!found) throw new LlmError('This model is not in the signed-in ChatGPT account’s catalog.', 'MODEL_NOT_FOUND')
+    return found
+  }
+
+  override async* stream(options: GenerateOptions): AsyncIterable<StreamChunk> {
+    const controller = new AbortController()
+    const signal = AbortSignal.any([controller.signal, ...options.signal ? [options.signal] : []])
+    let reader: ReadableStreamDefaultReader<Uint8Array> | undefined
+    try {
+      const token = await this.auth.accessToken()
+      const response = await this.auth.request('responses', {
+        method: 'POST', signal, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },
+        body: JSON.stringify(requestBody(options)),
+      })
+      if (!response.ok) { await response.body?.cancel(); throw new LlmError(`ChatGPT returned HTTP ${response.status}. Check your sign-in and plan usage.`, 'PROVIDER_ERROR') }
+      if (!response.body || !response.headers.get('content-type')?.includes('text/event-stream')) {
+        await response.body?.cancel(); throw new LlmError('ChatGPT did not return an event stream.', 'INVALID_RESPONSE')
+      }
+      reader = response.body.getReader()
+      const events: string[] = []
+      const parser = createParser({ onEvent: event => events.push(event.data) })
+      const decoder = new TextDecoder()
+      const blocks: ContentBlock[] = []
+      const slots = new Map<number, number>()
+      const items = new Map<number, Record<string, unknown>>()
+      let completed = false
+      while (!completed) {
+        const read = await reader.read()
+        parser.feed(decoder.decode(read.value, { stream: !read.done }))
+        if (read.done) parser.reset({ consume: true })
+        for (const raw of events.splice(0)) {
+          if (raw === '[DONE]') continue
+          const event = eventSchema.parse(JSON.parse(raw))
+          if (['response.failed', 'response.incomplete', 'error'].includes(event.type)) {
+            throw new LlmError(`ChatGPT response failed (${event.response?.error?.code ?? event.type}). Check ChatGPT usage or retry.`, 'PROVIDER_ERROR')
+          }
+          const output = event.output_index
+          if (output !== undefined && event.type === 'response.output_item.added' && event.item) {
+            const block = content(itemSchema.parse(event.item))
+            const index = blocks.length
+            slots.set(output, index); blocks.push(block)
+            yield { type: 'block-start', index, blockType: block.type }
+            if (block.type === 'tool-call') yield { type: 'tool-call-delta', index, id: block.id, name: block.name, argumentsDelta: block.arguments }
+          }
+          const index = output === undefined ? undefined : slots.get(output)
+          const block = index === undefined ? undefined : blocks[index]
+          if (index !== undefined && event.delta && block) {
+            if (event.type === 'response.output_text.delta' && block.type === 'text') {
+              block.text += event.delta; yield { type: 'text-delta', index, text: event.delta }
+            } else if (event.type === 'response.reasoning_summary_text.delta' && block.type === 'reasoning') {
+              block.text += event.delta; yield { type: 'reasoning-delta', index, text: event.delta }
+            } else if (event.type === 'response.function_call_arguments.delta' && block.type === 'tool-call') {
+              block.arguments += event.delta; yield { type: 'tool-call-delta', index, id: block.id, argumentsDelta: event.delta }
+            }
+          }
+          if (output !== undefined && event.type === 'response.output_item.done' && event.item) items.set(output, event.item)
+          if (event.type === 'response.completed') {
+            completed = true
+            for (const [output, item] of (event.response?.output ?? []).entries()) items.set(output, item)
+            const metadata: { item: Record<string, unknown> }[] = []
+            for (const [output, index] of slots) {
+              const item = items.get(output)
+              if (!item) throw new LlmError('ChatGPT omitted a completed output item.', 'INVALID_RESPONSE')
+              const final = content(itemSchema.parse(item)); blocks[index] = final
+              metadata[index] = { item }
+              yield { type: 'block-end', index, block: final }
+            }
+            const usage = event.response?.usage
+            if (usage) {
+              const cached = usage.input_tokens_details?.cached_tokens ?? 0
+              yield { type: 'usage', usage: { inputTokens: Math.max(0, usage.input_tokens - cached), outputTokens: usage.output_tokens,
+                cacheReadTokens: cached, ...usage.total_tokens === undefined ? {} : { totalTokens: usage.total_tokens },
+                ...usage.output_tokens_details?.reasoning_tokens === undefined ? {} : { reasoningTokens: usage.output_tokens_details.reasoning_tokens } } }
+            }
+            yield { type: 'finish', reason: { kind: blocks.some(block => block.type === 'tool-call') ? 'tool-calls' : 'stop' },
+              replayState: { response: { format: 'chatgpt-responses', model: options.model }, blocks: metadata } }
+            break
+          }
+        }
+        if (read.done) break
+      }
+      if (!completed) throw new LlmError('ChatGPT stream ended before response.completed.', 'TRUNCATED_STREAM')
+    } finally {
+      controller.abort()
+      if (reader) { await reader.cancel().catch(() => {}); reader.releaseLock() }
+    }
+  }
+}
diff --git a/packages/experimental/llm-chatgpt-browser/src/auth.ts b/packages/experimental/llm-chatgpt-browser/src/auth.ts
new file mode 100644
index 00000000..611bc853
--- /dev/null
+++ b/packages/experimental/llm-chatgpt-browser/src/auth.ts
@@ -0,0 +1,173 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { credentialKey } from '@deepseek-ai/dsh-credentials'
+import { createLocalJWKSet, jwtVerify } from 'jose'
+import { z } from 'zod'
+
+const key = credentialKey('llm-chatgpt-browser', 'chatgpt')
+const callback = 'http://127.0.0.1:1455/auth/callback'
+const resource = 'https://api.openai.com/v1'
+const scope = 'openid profile email offline_access resource.invoke chatgpt.tokens.use.direct'
+const grantSchema = z.object({
+  access: z.string(), refresh: z.string(), id: z.string(), clientId: z.string(), subject: z.string(),
+  email: z.string(), expires: z.number(), scope: z.string(), hostId: z.string(),
+})
+type Grant = z.infer<typeof grantSchema>
+const tokenSchema = z.object({
+  access_token: z.string().min(1), refresh_token: z.string().min(1).optional(), id_token: z.string().min(1).optional(),
+  token_type: z.string().regex(/^bearer$/i), expires_in: z.number().positive(), scope: z.string().optional(),
+})
+const encode = (bytes: Uint8Array): string => btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+const random = (): string => encode(crypto.getRandomValues(new Uint8Array(32)))
+
+/** Owns one disposable browser account. Secrets stay in the credential service. */
+export class ChatGPTAuth {
+  private pending: { state: string; nonce: string; verifier: string; hostId: string; clientId: string;
+    controller: AbortController; expires: number; consumed: boolean } | undefined
+  private registration: Pick<Grant, 'clientId' | 'subject' | 'email' | 'hostId'> | undefined
+  private account = new AbortController()
+
+  constructor(private readonly ctx: Context, private readonly lifetime: AbortSignal) {}
+
+  async request(route: string, init: RequestInit = {}): Promise<Response> {
+    return await fetch(`${globalThis.location.origin}/openai/${route}`, {
+      ...init, headers: { ...Object.fromEntries(new Headers(init.headers)), 'x-dsh-fetch': '1' },
+      signal: AbortSignal.any([this.lifetime, ...route === 'revoke' ? [] : [this.account.signal], AbortSignal.timeout(300000), ...init.signal ? [init.signal] : []]),
+      credentials: 'omit', cache: 'no-store', redirect: 'error',
+    })
+  }
+
+  async status(): Promise<{ connected: boolean; email: string }> {
+    const record = await this.ctx.credentials.readRecord(key)
+    const grant = record?.kind === 'grant' ? grantSchema.parse(record.payload) : undefined
+    return { connected: grant !== undefined, email: grant?.email ?? '' }
+  }
+
+  async begin(hostId: string): Promise<string> {
+    if (!/^urn:uuid:[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(hostId)) {
+      throw new Error('Invalid browser installation identifier')
+    }
+    this.cancel()
+    const pending = { state: random(), nonce: random(), verifier: random(), hostId,
+      clientId: this.registration?.clientId ?? 'dynamic_agent_client', controller: new AbortController(),
+      expires: Date.now() + 10 * 60_000, consumed: false }
+    this.pending = pending
+    const challenge = encode(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pending.verifier))))
+    pending.controller.signal.throwIfAborted()
+    const url = new URL('https://auth.openai.com/api/accounts/authorize')
+    url.search = new URLSearchParams({
+      client_id: pending.clientId, ext_agent_host_id: this.registration?.hostId ?? hostId,
+      ...pending.clientId === 'dynamic_agent_client' ? { agent_name_hint: 'DSH Flare' } : {},
+      response_type: 'code', redirect_uri: callback, resource, scope,
+      state: pending.state, nonce: pending.nonce, code_challenge: challenge, code_challenge_method: 'S256',
+    }).toString()
+    return url.href
+  }
+
+  cancel(): void { this.pending?.controller.abort(); this.pending = undefined }
+
+  private async tokens(body: URLSearchParams, signal: AbortSignal) {
+    const response = await this.request('token', {
+      method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' }, body,
+      signal: AbortSignal.any([signal, AbortSignal.timeout(30000)]),
+    })
+    if (!response.ok) { await response.body?.cancel(); throw new Error(`ChatGPT authorization returned HTTP ${response.status}. Start sign-in again.`) }
+    return tokenSchema.parse(await response.json())
+  }
+
+  private async identity(id: string, clientId: string, signal: AbortSignal, nonce?: string) {
+    const response = await this.request('jwks', { signal })
+    if (!response.ok) { await response.body?.cancel(); throw new Error('Could not verify ChatGPT sign-in') }
+    const { payload } = await jwtVerify(id, createLocalJWKSet(await response.json()), {
+      issuer: 'https://auth.openai.com', audience: clientId, requiredClaims: ['exp', 'sub'], algorithms: ['RS256'],
+    })
+    if (!payload.sub || (nonce !== undefined && payload.nonce !== nonce)) throw new Error('ChatGPT sign-in identity did not match')
+    return { subject: payload.sub, email: typeof payload.email === 'string' ? payload.email : payload.sub }
+  }
+
+  async complete(input: string): Promise<void> {
+    const pending = this.pending
+    if (!pending || pending.consumed || Date.now() >= pending.expires) throw new Error('Sign-in expired. Start again.')
+    pending.consumed = true
+    try {
+      let url: URL
+      try { url = new URL(input.trim()) } catch { throw new Error('Paste the full localhost callback URL') }
+      if (url.origin + url.pathname !== callback || url.hash || url.username || url.password
+        || url.searchParams.getAll('state').length !== 1 || url.searchParams.get('state') !== pending.state) {
+        throw new Error('This callback does not match the current sign-in. Start again.')
+      }
+      if (url.searchParams.has('error')) throw new Error('ChatGPT sign-in was declined. Start again to allow access.')
+      const code = url.searchParams.get('code')
+      const clientId = url.searchParams.get('client_id') ?? pending.clientId
+      if (!code || url.searchParams.getAll('code').length !== 1 || !clientId || clientId === 'dynamic_agent_client'
+        || url.searchParams.getAll('client_id').length > 1
+        || (pending.clientId !== 'dynamic_agent_client' && clientId !== pending.clientId)) {
+        throw new Error('The callback is missing a valid authorization code or client ID')
+      }
+      const token = await this.tokens(new URLSearchParams({
+        grant_type: 'authorization_code', client_id: clientId, code, code_verifier: pending.verifier,
+        redirect_uri: callback, resource,
+      }), pending.controller.signal)
+      if (!token.id_token || !token.refresh_token || !token.scope?.split(/\s+/).includes('chatgpt.tokens.use.direct')) {
+        throw new Error('Enable ChatGPT plan usage when approving this app, then sign in again')
+      }
+      const identity = await this.identity(token.id_token, clientId, pending.controller.signal, pending.nonce)
+      if (this.registration && identity.subject !== this.registration.subject) throw new Error('Sign in to the previously selected ChatGPT account')
+      const grant: Grant = { ...identity, clientId, access: token.access_token, refresh: token.refresh_token,
+        id: token.id_token, scope: token.scope, expires: Date.now() + token.expires_in * 1000,
+        hostId: this.registration?.hostId ?? pending.hostId }
+      await this.ctx.credentials.modifyRecord(key, async () => {
+        pending.controller.signal.throwIfAborted()
+        this.lifetime.throwIfAborted()
+        return { kind: 'grant', payload: grant }
+      })
+      this.registration = { clientId, ...identity, hostId: grant.hostId }
+    } finally {
+      if (this.pending === pending) this.pending = undefined
+    }
+  }
+
+  async accessToken(): Promise<string> {
+    const record = await this.ctx.credentials.modifyRecord(key, async current => {
+      if (current?.kind !== 'grant') throw new Error('Continue with ChatGPT in Settings → ChatGPT first')
+      const grant = grantSchema.parse(current.payload)
+      if (grant.expires > Date.now() + 60000) return undefined
+      const token = await this.tokens(new URLSearchParams({
+        grant_type: 'refresh_token', client_id: grant.clientId, refresh_token: grant.refresh, resource,
+      }), this.account.signal)
+      const granted = token.scope ?? grant.scope
+      if (!granted.split(/\s+/).includes('chatgpt.tokens.use.direct')) throw new Error('ChatGPT plan permission is no longer available. Sign in again.')
+      if (token.id_token) {
+        const identity = await this.identity(token.id_token, grant.clientId, this.account.signal)
+        if (identity.subject !== grant.subject) throw new Error('Refreshed ChatGPT identity did not match')
+      }
+      this.account.signal.throwIfAborted()
+      return { kind: 'grant', payload: { ...grant, access: token.access_token,
+        refresh: token.refresh_token ?? grant.refresh, id: token.id_token ?? grant.id, scope: granted,
+        expires: Date.now() + token.expires_in * 1000 } }
+    })
+    if (record?.kind !== 'grant') throw new Error('Sign in with ChatGPT first')
+    return grantSchema.parse(record.payload).access
+  }
+
+  async signOut(): Promise<boolean> {
+    this.cancel()
+    this.account.abort()
+    // Await any rotating-token write before revoking the newest refresh token.
+    const record = await this.ctx.credentials.modifyRecord(key, async () => undefined)
+    let revoked = true
+    try {
+      if (record?.kind === 'grant') {
+        const grant = grantSchema.parse(record.payload)
+        const response = await this.request('revoke', {
+          method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' },
+          body: new URLSearchParams({ token: grant.refresh, token_type_hint: 'refresh_token', client_id: grant.clientId }),
+          signal: AbortSignal.timeout(10000),
+        })
+        revoked = response.ok
+        await response.body?.cancel()
+      }
+    } catch { revoked = false }
+    finally { await this.ctx.credentials.deleteRecord(key); this.account = new AbortController() }
+    return revoked
+  }
+}
