diff --git a/deploy/flare/pack.ts b/deploy/flare/pack.ts
new file mode 100644
index 00000000..cff3a92a
--- /dev/null
+++ b/deploy/flare/pack.ts
@@ -0,0 +1,30 @@
+import { mkdirSync, readFileSync, writeFileSync, copyFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { loadOverlayPatches } from '@deepseek-ai/dsh-app-boot'
+import { collectModuleNames, packVfsImage } from '@deepseek-ai/dsh-experimental-webworker-packer'
+import {
+  configTrees, indexWorkspacePackages, installationManifest, platformHomePatch, profileRoster,
+} from '@deepseek-ai/dsh-experimental-webworker-packer/src/repository.ts'
+
+const root = process.cwd()
+const out = join(root, 'apps/web/dist')
+const overlay = loadOverlayPatches('flare', join(root, 'deploy/flare/cordis.patch.yml'))
+const extra = new Set<string>()
+collectModuleNames(overlay, extra)
+const installation = installationManifest(root)
+const originalManifest = readFileSync(installation.manifest, 'utf8')
+const manifest = JSON.parse(originalManifest) as { dependencies: Record<string, string> }
+for (const name of extra) manifest.dependencies[name] = '0.2.1-rc.3'
+writeFileSync(installation.manifest, JSON.stringify(manifest))
+const packed = (() => { try { return packVfsImage({
+  profile: 'web', roster: [...profileRoster(root, 'web').roster, ...extra], installation,
+  workspaces: indexWorkspacePackages(root), resolveFrom: root,
+  configTrees: configTrees(root), homePatch: [...platformHomePatch(root, 'web'), ...overlay],
+}) } finally { writeFileSync(installation.manifest, originalManifest) } })()
+if (packed.missing.length) throw new Error(`Missing packages: ${packed.missing.join(', ')}`)
+for (const archive of [{ name: 'vfs-image.tar.gz', image: packed.image }, ...packed.lazyArchives]) {
+  const destination = join(out, 'preview', archive.name)
+  mkdirSync(dirname(destination), { recursive: true })
+  writeFileSync(destination, archive.image)
+}
+copyFileSync(join(out, 'preview.html'), join(out, 'index.html'))
