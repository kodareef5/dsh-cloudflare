@@ -0,0 +1,28 @@
+import { Context } from '@deepseek-ai/cordis'
+import { Remote, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import { ChatGPTAuth } from './auth.ts'
+import { ChatGPTAdapter } from './adapter.ts'
+
+/** Browser account operations; the Remote response never contains credentials. */
+export default class ChatGPTBrowser extends TypertRemoteService {
+  static inject = ['llm', 'credentials']
+  private readonly auth: ChatGPTAuth
+  constructor(ctx: Context) {
+    super(ctx, 'chatgpt', { namespace: 'chatgpt' })
+    const lifetime = new AbortController()
+    this.auth = new ChatGPTAuth(ctx, lifetime.signal)
+    ctx.effect(() => () => { lifetime.abort(); this.auth.cancel() })
+    ctx.llm.registerAdapter(['chatgpt'], new ChatGPTAdapter(this.auth))
+  }
+
+  @Remote
+  async status(): Promise<{ connected: boolean; email: string }> { return await this.auth.status() }
+  @Remote
+  async begin(hostId: string): Promise<string> { return await this.auth.begin(hostId) }
+  @Remote
+  async complete(callback: string): Promise<void> { await this.auth.complete(callback) }
+  @Remote
+  async cancel(): Promise<void> { this.auth.cancel() }
+  @Remote
+  async signOut(): Promise<boolean> { return await this.auth.signOut() }
+}
