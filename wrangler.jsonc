{
  "name": "dsh-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2026-10-24",
  "ratelimits": [
    { "name": "NETWORK_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "UNLOCK_ATTEMPTS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/unlock", "/fetch", "/openai/*"]
  }
}
